# ── Backend API ────────────────────────────────────────────────────────────────
# URL base del backend REST. Cuando está definida, la app usa la API en lugar
# de localStorage. Sin esta variable la app funciona en modo offline/local.
#
# Ejemplo: http://localhost:3000   ó   https://api.tudominio.com
VITE_API_URL=

# ── Google OAuth ────────────────────────────────────────────────────────────────
# Client ID de Google Identity Services (ya hardcodeado en useAuth.js,
# mover aquí si se quiere configurar por entorno)
# VITE_GOOGLE_CLIENT_ID=628635003355-xxxx.apps.googleusercontent.com

# ── Supabase ───────────────────────────────────────────────────────────────────
# Cliente preparado en src/services/supabaseClient.js (aún sin uso en los services).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Email de respuesta (Google Apps Script) ──────────────────────────────────────
# Web App de Apps Script que envía el correo al solicitante (y CC) cuando un
# admin marca "ENVIAR = SI" al responder desde el Panel. Ver
# google-apps-script/EmailResponder.gs para el código y los pasos de despliegue.
VITE_RESPUESTA_WEBHOOK_URL=
VITE_RESPUESTA_WEBHOOK_SECRET=
